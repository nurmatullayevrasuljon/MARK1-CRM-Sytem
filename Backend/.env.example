# Mark1 CRM Backend — o'zgaruvchilar namunasi.
# Ishlatish: bu faylni `.env` ga nusxalab, qiymatlarni to'ldiring.
# `.env` hech qachon git'ga yuborilmaydi (.gitignore'da).

# ===== Asosiy =====
# Server porti
PORT=3000

# MongoDB ulanish URI (Atlas yoki lokal)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mark1-crm

# ===== JWT =====
# Access token 15 daqiqada, refresh 7 kunda tugaydi.
ACCESS_SECRET=almashtiring-uzun-tasodifiy-qator
REFRESH_SECRET=almashtiring-boshqa-uzun-qator

# ===== SMS (DevSMS.uz) =====
DEVSMS_API_TOKEN=token-mark1-uchun

# ===== AI overview (OpenAI) — ixtiyoriy =====
# Kalit bo'lmasa AI kartada qoidaviy fallback matn ko'rsatiladi.
OPENAI_API_KEY=

# ===== Mobil ilova versiyasi (GET /api/app/version) =====
LATEST_APP_VERSION=1.0.3
LATEST_VERSION_CODE=5005
MIN_SUPPORTED_VERSION_CODE=5001
FORCE_UPDATE=false
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=uz.mark1.crm
# Play Store'da ilova chiqmagunicha to'g'ridan-to'g'ri APK yuklab olish URL
APK_URL=
APP_CHANGELOG=Yangi imkoniyatlar qo'shildi, xavfsizlik va tezkorlik oshirildi.

# ===== CORS =====
# Qo'shimchi originlar (vergul bilan). Asosiy ro'yxat server.js'da.
# ALLOWED_ORIGINS=https://staging.mark1.uz,https://boshqa-sayt.uz
